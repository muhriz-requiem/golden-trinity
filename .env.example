# Environment template for GoldenTrinity.
#
# The original .env is NOT published: it contained live credentials. All of the
# following were rotated before this repository was made public. Fill in your own
# values; every one of these is optional for offline inspection.

# --- runtime ---
TRADING_MODE=paper

# --- Alpaca (paper only; the original .env also held a live key, now rotated) ---
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=

# --- forex (unused; US residents cannot open SSN-requiring accounts) ---
FXCM_API_TOKEN=
FXCM_DEMO=true

# --- macro data ---
FRED_API_KEY=
NEWS_API_KEY=

# --- alerting (webhook URLs are full credentials; never commit real ones) ---
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_TRADES=
DISCORD_WEBHOOK_REPORTS=
DISCORD_WEBHOOK_HEALTH=

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goldentrinity
DB_USER=gt_user
DB_PASS=

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- n8n ---
# Must be exactly 32 characters. Changing it after first run invalidates every
# credential n8n has stored.
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_TRADE_FILLED=http://localhost:5678/webhook/trade-filled
N8N_WEBHOOK_RISK_ALERT=http://localhost:5678/webhook/risk-alert
